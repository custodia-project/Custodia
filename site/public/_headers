# Cabeceras de Cloudflare Pages para el sitio de producto.
# Cada ruta aparece en una sola regla para que no se pisen.

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff

# El HTML y los archivos de descubrimiento se revalidan en cada visita, así
# un deploy se ve enseguida.
/
  Cache-Control: public, max-age=0, must-revalidate
/es/
  Cache-Control: public, max-age=0, must-revalidate
/inventory/
  Cache-Control: public, max-age=0, must-revalidate
/connectors/
  Cache-Control: public, max-age=0, must-revalidate
/connectors/*
  Cache-Control: public, max-age=0, must-revalidate
/install/
  Cache-Control: public, max-age=0, must-revalidate
/limits/
  Cache-Control: public, max-age=0, must-revalidate
/es/inventario/
  Cache-Control: public, max-age=0, must-revalidate
/es/conectores/
  Cache-Control: public, max-age=0, must-revalidate
/es/conectores/*
  Cache-Control: public, max-age=0, must-revalidate
/es/instalar/
  Cache-Control: public, max-age=0, must-revalidate
/es/limites/
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Archivos con hash en el nombre (Vite) o versión en la URL (capturas).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/shots/*
  Cache-Control: public, max-age=31536000, immutable

# Instalación: el script, la clave y el catálogo del canal cambian con cada
# release y se revalidan siempre. Las versiones publicadas quedan con el
# cacheo por defecto.
/install.sh
  Cache-Control: public, max-age=0, must-revalidate
/install.sh.sig
  Cache-Control: public, max-age=0, must-revalidate
/allowed_signers
  Cache-Control: public, max-age=0, must-revalidate
/releases/stable/*
  Cache-Control: public, max-age=0, must-revalidate
